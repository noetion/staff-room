    "qa:visual:acceptance": "node scripts/qa/visual-qa.mjs --skip-perf"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
